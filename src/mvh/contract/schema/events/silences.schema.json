{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/silences.schema.json",
 "title": "mvh/events/silences",
 "x-contract-version": "1.0.0-rc.1",
 "description": "silent stretches",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/silences"
    },
    "name": {
     "const": "silences"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "Dynamics silence id",
        "pattern": "^Z\\d{3,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "depth_db": {
        "type": "number",
        "x-unit": "dB",
        "description": "below integrated loudness"
       }
      },
      "required": [
       "d",
       "depth_db",
       "id",
       "t"
      ]
     }
    }
   }
  }
 ]
}
