{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/singing.schema.json",
 "title": "mvh/events/singing",
 "x-contract-version": "1.0.0-rc.1",
 "description": "who sings when: lines joined with voices and characters (singerAt reads this)",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/singing"
    },
    "name": {
     "const": "singing"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "character_id": {
        "type": "string",
        "description": "Character (from intent.md or meaning) id",
        "pattern": "^C[1-9]\\d*$"
       },
       "voice_id": {
        "type": "string",
        "description": "Voice cluster (one singing or rapping voice) id",
        "pattern": "^V[1-9]\\d*$"
       },
       "line_id": {
        "type": "string",
        "description": "Lyric line, in sung order id",
        "pattern": "^L\\d{3,}$"
       },
       "lead_backing": {
        "type": "string",
        "enum": [
         "lead",
         "backing"
        ]
       }
      },
      "required": [
       "character_id",
       "d",
       "lead_backing",
       "line_id",
       "t",
       "voice_id"
      ]
     }
    }
   }
  }
 ]
}
