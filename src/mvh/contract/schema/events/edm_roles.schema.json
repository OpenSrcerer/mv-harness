{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/edm_roles.schema.json",
 "title": "mvh/events/edm_roles",
 "x-contract-version": "1.0.0-rc.3",
 "description": "THE definition of builds, drops and breakdowns (snapped to downbeats)",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/edm_roles"
    },
    "name": {
     "const": "edm_roles"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "EDM-role segment (build, drop, breakdown) id",
        "pattern": "^R\\d{2,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "role": {
        "type": "string",
        "enum": [
         "build",
         "drop",
         "breakdown"
        ]
       },
       "start_bar": {
        "type": "integer",
        "minimum": 0
       },
       "n_bars": {
        "type": "integer",
        "minimum": 1
       },
       "section_id": {
        "type": "string",
        "description": "Section id",
        "pattern": "^S\\d{2,}$"
       },
       "conf": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "evidence": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "conf",
       "d",
       "id",
       "n_bars",
       "role",
       "section_id",
       "start_bar",
       "t"
      ]
     }
    }
   }
  }
 ]
}
