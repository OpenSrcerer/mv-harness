{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/stops.schema.json",
 "title": "mvh/events/stops",
 "x-contract-version": "1.0.0-rc.3",
 "description": "sudden cuts to (near) silence",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/stops"
    },
    "name": {
     "const": "stops"
    },
    "kind": {
     "const": "event"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "Dynamics stop (sudden cut) id",
        "pattern": "^X\\d{3,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "strength": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "gap_s": {
        "type": "number",
        "x-unit": "s",
        "minimum": 0
       }
      },
      "required": [
       "gap_s",
       "id",
       "strength",
       "t"
      ]
     }
    }
   }
  }
 ]
}
