{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/pulse_regions.schema.json",
 "title": "mvh/events/pulse_regions",
 "x-contract-version": "1.0.0-rc.2",
 "description": "regions with / without a perceptible beat, covering the whole song",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/pulse_regions"
    },
    "name": {
     "const": "pulse_regions"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "in_pulse": {
        "type": "boolean"
       }
      },
      "required": [
       "d",
       "in_pulse",
       "t"
      ]
     }
    }
   }
  }
 ]
}
