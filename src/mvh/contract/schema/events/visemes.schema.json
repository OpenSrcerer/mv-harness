{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/visemes.schema.json",
 "title": "mvh/events/visemes",
 "x-contract-version": "1.0.0-rc.2",
 "description": "Rhubarb mouth shapes A-H, X (Preston Blair mapping in CONTRACT.md)",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/visemes"
    },
    "name": {
     "const": "visemes"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "viseme": {
        "type": "string",
        "enum": [
         "A",
         "B",
         "C",
         "D",
         "E",
         "F",
         "G",
         "H",
         "X"
        ]
       },
       "voice_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Voice cluster (one singing or rapping voice) id",
        "pattern": "^V[1-9]\\d*$"
       },
       "line_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Lyric line, in sung order id",
        "pattern": "^L\\d{3,}$"
       }
      },
      "required": [
       "d",
       "line_id",
       "t",
       "viseme",
       "voice_id"
      ]
     }
    }
   }
  }
 ]
}
