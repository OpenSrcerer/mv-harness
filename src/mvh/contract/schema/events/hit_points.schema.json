{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/hit_points.schema.json",
 "title": "mvh/events/hit_points",
 "x-contract-version": "1.0.0-rc.3",
 "description": "ranked coinciding accents",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/hit_points"
    },
    "name": {
     "const": "hit_points"
    },
    "kind": {
     "const": "event"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "Choreography hit point id",
        "pattern": "^H\\d{3,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "strength": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "rank": {
        "type": "integer",
        "minimum": 1
       },
       "kinds": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "what coincides: drum, onset, impact, stop, vocal_onset, chord, ..."
       },
       "sources": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "file": {
           "type": "string",
           "description": "path relative to the song folder"
          },
          "id": {
           "type": "string",
           "description": "item id, or a reference key 'beat:<beat_index>' / 'bar:<bar>'"
          }
         },
         "required": [
          "file",
          "id"
         ],
         "description": "link to the item a derived item comes from"
        }
       }
      },
      "required": [
       "id",
       "kinds",
       "rank",
       "sources",
       "strength",
       "t"
      ]
     }
    }
   }
  }
 ]
}
