{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/vocal_style.schema.json",
 "title": "mvh/events/vocal_style",
 "x-contract-version": "1.0.0-rc.1",
 "description": "lead-vocal style segments",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/vocal_style"
    },
    "name": {
     "const": "vocal_style"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "style": {
        "type": "string",
        "enum": [
         "singing",
         "speech",
         "rap"
        ]
       },
       "conf": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       }
      },
      "required": [
       "conf",
       "d",
       "style",
       "t"
      ]
     }
    }
   }
  }
 ]
}
