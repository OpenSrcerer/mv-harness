{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/mood.schema.json",
 "title": "mvh/events/mood",
 "x-contract-version": "1.0.0-rc.3",
 "description": "mood per section",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/mood"
    },
    "name": {
     "const": "mood"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "section_id": {
        "type": "string",
        "description": "Section id",
        "pattern": "^S\\d{2,}$"
       },
       "valence": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "arousal": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "valence_conf": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "arousal_conf": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "tags": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "top mood/theme tags"
       }
      },
      "required": [
       "arousal",
       "arousal_conf",
       "d",
       "section_id",
       "t",
       "tags",
       "valence",
       "valence_conf"
      ]
     }
    }
   }
  }
 ]
}
