{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/hits.mid.schema.json",
 "title": "mvh/events/hits.mid",
 "x-contract-version": "1.0.0-rc.1",
 "description": "mid hit events from the viz hit envelope (refined on a 2.5 ms envelope)",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/hits.mid"
    },
    "name": {
     "const": "hits.mid"
    },
    "kind": {
     "const": "event"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "t_peak": {
        "type": "number",
        "x-unit": "s",
        "description": "time of the envelope peak"
       },
       "strength": {
        "type": "number",
        "x-unit": "0..1+",
        "description": "1 ~ a typical hit",
        "minimum": 0
       },
       "db": {
        "type": "number",
        "x-unit": "dBFS",
        "description": "band level at the peak"
       }
      },
      "required": [
       "db",
       "strength",
       "t",
       "t_peak"
      ]
     }
    }
   }
  }
 ]
}
