{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/decay_tails.schema.json",
 "title": "mvh/events/decay_tails",
 "x-contract-version": "1.0.0-rc.3",
 "description": "ringing-out tails after hits or section ends",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/decay_tails"
    },
    "name": {
     "const": "decay_tails"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "Dynamics decay tail id",
        "pattern": "^Y\\d{3,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "strength": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       }
      },
      "required": [
       "d",
       "id",
       "strength",
       "t"
      ]
     }
    }
   }
  }
 ]
}
