{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/counts.schema.json",
 "title": "mvh/events/counts",
 "x-contract-version": "1.0.0-rc.2",
 "description": "eight-counts; restart at every phrase and section start; E000 = synthesised 5-6-7-8 lead-in",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/counts"
    },
    "name": {
     "const": "counts"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "description": "Eight-count (E000 = synthesised lead-in) id",
        "pattern": "^E\\d{3,}$"
       },
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "start_beat": {
        "type": "integer",
        "description": "beat_index of the first count (may be < 0 for the E000 lead-in)"
       },
       "len": {
        "type": "integer",
        "description": "beats in this count: 8 (6 in 3/4), shorter when partial",
        "minimum": 1,
        "maximum": 8
       },
       "first_count": {
        "type": "integer",
        "description": "1, or 5 for the E000 lead-in",
        "minimum": 1,
        "maximum": 8
       },
       "phrase_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Phrase (4/8/16 bars) id",
        "pattern": "^P\\d{2,}$"
       },
       "section_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Section id",
        "pattern": "^S\\d{2,}$"
       },
       "partial": {
        "type": "boolean"
       },
       "lead_in": {
        "type": "boolean"
       },
       "in_pulse": {
        "type": "boolean"
       },
       "accents": {
        "type": "array",
        "items": {
         "type": "number",
         "x-unit": "0..1",
         "minimum": 0,
         "maximum": 1
        },
        "description": "accent per count (len entries)"
       }
      },
      "required": [
       "accents",
       "d",
       "first_count",
       "id",
       "in_pulse",
       "lead_in",
       "len",
       "partial",
       "phrase_id",
       "section_id",
       "start_beat",
       "t"
      ]
     }
    }
   }
  }
 ]
}
