{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/instruments.schema.json",
 "title": "mvh/events/instruments",
 "x-contract-version": "1.0.0-rc.2",
 "description": "instrument timeline segments",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/instruments"
    },
    "name": {
     "const": "instruments"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "instrument": {
        "type": "string",
        "description": "instrument slug",
        "pattern": "^[a-z0-9_]+$"
       },
       "conf": {
        "type": "number",
        "x-unit": "0..1",
        "minimum": 0,
        "maximum": 1
       },
       "evidence": {
        "type": "string",
        "enum": [
         "stem",
         "tagger",
         "both"
        ]
       },
       "stem": {
        "type": [
         "string",
         "null"
        ],
        "enum": [
         "vocals",
         "lead_vocals",
         "backing_vocals",
         "drums",
         "bass",
         "guitar",
         "piano",
         "other",
         "instrumental",
         "drums_kick",
         "drums_snare",
         "drums_toms",
         "drums_hihat",
         "drums_ride",
         "drums_crash",
         null
        ]
       }
      },
      "required": [
       "conf",
       "d",
       "evidence",
       "instrument",
       "stem",
       "t"
      ]
     }
    }
   }
  }
 ]
}
