{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/events/phonemes.schema.json",
 "title": "mvh/events/phonemes",
 "x-contract-version": "1.0.0-rc.1",
 "description": "phonemes",
 "allOf": [
  {
   "$ref": "https://mv-harness.local/schema/envelope/events.schema.json"
  },
  {
   "properties": {
    "schema": {
     "const": "mvh/events/phonemes"
    },
    "name": {
     "const": "phonemes"
    },
    "kind": {
     "const": "segment"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "t": {
        "type": "number",
        "x-unit": "s",
        "description": "time in seconds from the first sample of audio/mix.flac"
       },
       "d": {
        "type": "number",
        "x-unit": "s",
        "description": "duration in seconds",
        "minimum": 0
       },
       "phoneme": {
        "type": "string",
        "description": "ARPAbet or IPA symbol"
       },
       "voice_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Voice cluster (one singing or rapping voice) id",
        "pattern": "^V[1-9]\\d*$"
       },
       "word_id": {
        "type": [
         "string",
         "null"
        ],
        "description": "Lyric word (line_id.k, k 1-based) id",
        "pattern": "^L\\d{3,}\\.\\d{2,}$"
       }
      },
      "required": [
       "d",
       "phoneme",
       "t",
       "voice_id",
       "word_id"
      ]
     }
    }
   }
  }
 ]
}
