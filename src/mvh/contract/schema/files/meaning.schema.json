     "occurrence_label": {
      "type": "string"
     },
     "feel": {
      "type": [
       "string",
       "null"
      ]
     },
     "meaning": {
      "type": [
       "string",
       "null"
      ]
     },
     "emotion": {
      "type": "object",
      "properties": {
       "lyric": {
        "type": [
         "string",
         "null"
        ]
       },
       "audio": {
        "type": [
         "string",
         "null"
        ]
       },
       "agree": {
        "type": [
         "boolean",
         "null"
        ]
       }
      },
      "required": [
