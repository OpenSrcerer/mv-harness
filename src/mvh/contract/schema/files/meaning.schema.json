      }
     },
     "movement_hint": {
      "type": [
       "string",
       "null"
      ]
     },
     "camera_hint": {
      "type": [
       "string",
       "null"
      ]
     },
     "characters_present": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Character (from intent.md or meaning) id",
       "pattern": "^C[1-9]\\d*$"
      }
     },
     "do_not": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "provenance": {
      "type": "object",
      "properties": {
       "source": {
        "type": "string",
        "description": "who/what supports the claim; precedence user > lyric > audio > external > speculative",
        "enum": [
         "user",
         "lyric",
         "audio",
         "external",
         "speculative"
        ]
       },
       "status": {
        "type": "string",
        "enum": [
         "user",
         "draft"
        ]
       },
       "cites": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "description": "a cited ID (L001, S03, Q0012, ...)"
          },
          "t0": {
           "type": "number",
           "x-unit": "s"
          },
          "t1": {
           "type": "number",
           "x-unit": "s"
          },
          "quote": {
           "type": "string",
           "description": "at most 10 words"
          }
         },
         "required": [],
         "description": "citation: an ID and/or a time range"
        }
       }
      },
      "required": [
       "cites",
       "source",
       "status"
      ]
     }
    },
    "required": [
     "camera_hint",
     "characters_present",
     "do_not",
     "emotion",
     "feel",
     "meaning",
     "movement_hint",
     "occurrence_label",
     "palette_hint",
     "provenance",
     "section_id",
     "t0",
     "t1"
    ]
   }
  },
  "palette": {
   "type": "array",
   "items": {
    "type": "string",
    "description": "colour as #rrggbb",
    "pattern": "^#[0-9a-fA-F]{6}$"
   }
  },
  "tone": {
   "type": [
    "string",
    "null"
   ]
  },
  "do_not": {
   "type": "array",
   "items": {
    "type": "string",
    "description": "the user's words, verbatim"
   }
  },
  "open_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "provenance": {
   "$ref": "https://mv-harness.local/schema/envelope/provenance.schema.json"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string",
    "description": "the user's own words, verbatim: free text of meaning/intent.md and the template's notes; direction, never a field or a rule"
   }
  },
  "references": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "field_sources": {
   "type": "object",
   "properties": {},
   "required": [],
   "description": "per top-level field: user (intent template / notes) | draft (authored.json)"
  },
  "intent_form": {
   "type": "string",
   "description": "how meaning/intent.md was read: none | yaml (template) | text (notes) | yaml+text, +viewer when the viewer block is present"
  }
 },
 "required": [
  "characters",
  "do_not",
  "logline",
  "motifs",
  "open_questions",
  "palette",
  "perspective",
  "schema",
  "schema_version",
  "sections",
  "setting",
  "status",
