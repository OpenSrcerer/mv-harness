{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mv-harness.local/schema/tables/sections.schema.json",
 "title": "mvh/tables/sections",
 "x-contract-version": "1.0.0-rc.1",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "description": "Section id",
   "pattern": "^S\\d{2,}$"
  },
  "t": {
   "type": "number",
   "x-unit": "s",
   "description": "time in seconds from the first sample of audio/mix.flac"
  },
  "d": {
   "type": "number",
   "x-unit": "s",
   "description": "duration in seconds",
   "minimum": 0
  },
  "label": {
   "type": "string"
  },
  "occurrence": {
   "type": "integer",
   "minimum": 1
  },
  "repeat_group": {
   "type": "string",
   "description": "Section repeat group (A, B, ..., Z, AA, AB, ...) id",
   "pattern": "^[A-Z]{1,2}$"
  },
  "start_bar": {
   "type": "integer",
   "minimum": 0
  },
  "n_bars": {
   "type": "integer",
   "minimum": 1
  },
  "edm_role": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    "build",
    "drop",
    "breakdown",
    null
   ]
  },
  "level": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    "silence",
    "quiet",
    "soft",
    "medium",
    "loud",
    "peak",
    null
   ]
  },
  "mean_lufs": {
   "type": [
    "number",
    "null"
   ],
   "x-unit": "LUFS"
  }
 },
 "required": [
  "d",
  "edm_role",
  "id",
  "label",
  "level",
  "mean_lufs",
  "n_bars",
  "occurrence",
  "repeat_group",
  "start_bar",
  "t"
 ],
 "x-columns": [
  "id",
  "t",
  "d",
  "label",
  "occurrence",
  "repeat_group",
  "start_bar",
  "n_bars",
  "edm_role",
  "level",
  "mean_lufs"
 ],
 "x-sep": ",",
 "x-format": "csv",
 "description": "one row per section (from events/sections.json). Row schema after coercion (schemas.coerce_row): empty cell = null, booleans 0/1, UTF-8 without BOM, LF, header row first."
}
